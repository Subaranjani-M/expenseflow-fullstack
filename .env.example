# ==========================================
# ExpenseFlow Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Supports local standalone mongod, MongoDB Atlas, or automatically falls back to embedded in-memory MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/expenseflow

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRE=30d

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API URL (Client)
VITE_API_URL=http://localhost:5000/api
